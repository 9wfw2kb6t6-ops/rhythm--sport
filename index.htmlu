<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Configure a padel court concept with Rhythm Sport and request a tailored quotation for court supply, equipment and installation, subject to country and project review.">
<meta name="theme-color" content="#101713">
<title>Rhythm Sport | Premium Padel Solutions</title>
<style>
:root{--ink:#101713;--ink2:#18231c;--green:#b9f36b;--paper:#f5f6f1;--muted:#aab5ab;--line:rgba(255,255,255,.14);--darkline:rgba(16,23,19,.14)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper)}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.topbar{background:#0a0f0c;color:#dbe4da;font-size:12px;padding:9px 0}.topbar .wrap{display:flex;justify-content:space-between;gap:12px}.nav{background:var(--ink);color:white;position:sticky;top:0;z-index:20;border-bottom:1px solid var(--line)}.navin{height:76px;display:flex;align-items:center;justify-content:space-between;gap:22px}.brand{font-weight:900;letter-spacing:1.6px;font-size:21px;display:flex;align-items:center;gap:10px}.brandmark{width:31px;height:31px;border:2px solid var(--green);border-radius:50%;display:grid;place-items:center;color:var(--green);font-size:17px}.brand small{display:block;font-size:9px;letter-spacing:3px;color:#9eaa9f;margin-top:2px}.links{display:flex;align-items:center;gap:25px;font-size:13px;color:#d5ddd5}.links a:hover{color:var(--green)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 19px;background:var(--green);color:var(--ink);font-weight:800;font-size:12px;letter-spacing:.5px;border:0;border-radius:3px;cursor:pointer;transition:.2s}.btn:hover{transform:translateY(-2px);filter:brightness(1.04)}.btn-outline{border:1px solid rgba(255,255,255,.55);color:white;background:transparent}.menu{display:none;background:transparent;color:white;border:1px solid var(--line);padding:9px 12px;border-radius:3px}.hero{background:var(--ink);color:white;position:relative;overflow:hidden;min-height:610px;display:flex;align-items:center}.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,15,11,.96) 0%,rgba(9,15,11,.78) 46%,rgba(9,15,11,.16) 100%),url('https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=2000&q=85') center/cover no-repeat;opacity:.94}.hero:after{content:"";position:absolute;inset:auto 0 0;height:130px;background:linear-gradient(transparent,var(--ink))}.hero .wrap{position:relative;z-index:1;padding-top:65px;padding-bottom:90px}.eyebrow{font-size:11px;letter-spacing:2.6px;text-transform:uppercase;color:var(--green);font-weight:800;display:flex;align-items:center;gap:10px}.eyebrow:before{content:"";width:28px;height:2px;background:var(--green)}h1{font-size:clamp(44px,7vw,82px);line-height:.99;letter-spacing:-3px;max-width:720px;margin:24px 0 22px;font-weight:850}h1 span{color:var(--green)}.hero p{font-size:16px;line-height:1.8;color:#d2d9d1;max-width:510px;margin:0 0 30px}.actions{display:flex;gap:12px;flex-wrap:wrap}.hero-note{display:flex;align-items:center;gap:12px;margin-top:60px;color:#d4ddd4;font-size:11px;letter-spacing:1.2px;text-transform:uppercase}.hero-note b{height:1px;width:45px;background:var(--green)}.section{padding:92px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:36px}.kicker{color:#47702e;font-size:11px;letter-spacing:2px;font-weight:900;text-transform:uppercase}.section h2{font-size:clamp(30px,4vw,48px);line-height:1.08;letter-spacing:-1.5px;margin:12px 0 0}.section-head p{max-width:390px;color:#626b62;line-height:1.7;font-size:14px;margin:0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:white;border:1px solid #e4e8df;min-width:0}.cardimg{height:225px;background:#dce5d8;overflow:hidden}.cardimg img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}.card:hover .cardimg img{transform:scale(1.04)}.cardbody{padding:23px}.tag{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#5d7850;font-weight:900}.card h3{font-size:21px;margin:10px 0}.card p{font-size:13px;line-height:1.7;color:#677067;margin:0 0 18px}.textlink{font-size:12px;font-weight:900;display:inline-flex;align-items:center;gap:8px}.textlink span{color:#54832f;font-size:18px}.band{background:#dff0d0;padding:30px 0}.bandin{display:flex;justify-content:space-between;align-items:center;gap:20px}.band h2{font-size:clamp(23px,3vw,34px);margin:0;letter-spacing:-1px}.band p{color:#53604e;font-size:13px;margin:8px 0 0}.band .btn{white-space:nowrap}.projects{background:#111a14;color:white}.projects .section-head p{color:#b6c0b6}.projects .kicker{color:var(--green)}.projectgrid{display:grid;grid-template-columns:1.25fr 1fr;gap:18px}.project{position:relative;min-height:330px;overflow:hidden;background:#28382c}.project img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;opacity:.78}.project:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(6,12,8,.9),transparent 70%)}.projecttext{position:absolute;z-index:1;bottom:25px;left:25px;right:25px}.projecttext small{color:var(--green);text-transform:uppercase;letter-spacing:1.5px;font-weight:800}.projecttext h3{font-size:25px;margin:8px 0}.projecttext p{color:#d0d8d0;font-size:13px;margin:0}.process{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step{border-top:1px solid #cdd5c9;padding:20px 15px 10px 0}.step b{color:#6c944a;font-size:12px;letter-spacing:1px}.step h3{font-size:18px;margin:13px 0 8px}.step p{font-size:13px;color:#667066;line-height:1.65;margin:0}.quote{background:#e9eee5}.quotegrid{display:grid;grid-template-columns:.8fr 1.2fr;gap:55px;align-items:start}.quoteintro h2{font-size:clamp(32px,4vw,48px);line-height:1.06;letter-spacing:-1.5px;margin:14px 0}.quoteintro p{color:#5f695f;line-height:1.8;font-size:14px}.contactline{margin-top:28px;padding-top:20px;border-top:1px solid #cbd4c6;font-size:12px;color:#586456}.formbox{background:white;padding:28px;border:1px solid #dfe5da}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:11px;font-weight:800;letter-spacing:.4px}.field input,.field select,.field textarea{width:100%;border:1px solid #d8dfd4;background:#fbfcf9;padding:13px 12px;border-radius:2px;outline:none;color:#18231c}.field input:focus,.field select:focus,.field textarea:focus{border-color:#709b4d}.field textarea{min-height:100px;resize:vertical}.formbox .btn{margin-top:17px;width:100%}.formnote{font-size:11px;color:#778174;line-height:1.5;margin-top:12px}.footer{background:#0a100c;color:white;padding:45px 0 22px}.footergrid{display:flex;justify-content:space-between;gap:35px;flex-wrap:wrap;padding-bottom:35px}.footer p{color:#a9b4a9;max-width:330px;font-size:13px;line-height:1.7}.footlinks{display:flex;gap:18px;flex-wrap:wrap;color:#d0d8cf;font-size:12px}.copyright{border-top:1px solid var(--line);padding-top:18px;color:#869186;font-size:11px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.mobilecta{display:none}.notice{display:none;padding:12px;margin-top:12px;background:#e8f5dd;color:#28451e;font-size:13px;line-height:1.5}
@media(max-width:850px){.links{gap:14px}.links a:not(.btn){display:none}.menu{display:block}.navin{height:68px}.links.open{display:flex;position:absolute;top:68px;left:0;right:0;background:#101713;padding:20px;flex-direction:column;align-items:stretch;border-top:1px solid var(--line)}.links.open a:not(.btn){display:block;padding:8px}.links .btn{display:none}.hero{min-height:590px}.hero:before{background:linear-gradient(90deg,rgba(9,15,11,.94),rgba(9,15,11,.58)),url('https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=1400&q=80') center/cover}.cards{grid-template-columns:1fr 1fr}.cards .card:last-child{grid-column:1/-1}.section{padding:70px 0}.section-head{align-items:start;flex-direction:column}.projectgrid{grid-template-columns:1fr 1fr}.project{min-height:280px}.quotegrid{grid-template-columns:1fr;gap:25px}.process{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.wrap{width:min(100% - 30px,1160px)}.topbar .wrap{font-size:10px}.topbar .wrap span:last-child{display:none}.brand{font-size:18px}.hero{min-height:620px}.hero .wrap{padding-top:62px;padding-bottom:75px}h1{font-size:48px;letter-spacing:-2px}.hero p{font-size:14px}.actions .btn{width:100%}.hero-note{margin-top:42px}.section{padding:60px 0}.cards{grid-template-columns:1fr}.cards .card:last-child{grid-column:auto}.cardimg{height:220px}.bandin{align-items:flex-start;flex-direction:column}.band .btn{width:100%}.projectgrid{grid-template-columns:1fr}.project{min-height:280px}.process{grid-template-columns:1fr 1fr;gap:22px 12px}.formbox{padding:18px}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.footergrid{flex-direction:column}.mobilecta{display:flex;position:fixed;z-index:30;bottom:0;left:0;right:0;padding:10px 15px;background:rgba(10,16,12,.96);border-top:1px solid var(--line)}.mobilecta .btn{width:100%}body{padding-bottom:65px}.copyright{font-size:10px}}

/* RHYTHM SPORT PRO V2 — refined dark premium system */
:root{--ink:#101410;--ink2:#171e17;--green:#c7f36b;--paper:#101410;--muted:#aab4a7;--line:rgba(255,255,255,.14);--darkline:rgba(255,255,255,.14)}
body{background:#101410;color:#f3f5ef}
.topbar{background:#c7f36b;color:#11170e;font-weight:800;letter-spacing:.08em}
.nav{background:rgba(16,20,16,.94);backdrop-filter:blur(16px)}
.brandmark{border-radius:10px;transform:rotate(-4deg)}
.hero{min-height:650px}
.hero:before{background:linear-gradient(90deg,rgba(9,15,11,.97) 0%,rgba(9,15,11,.75) 48%,rgba(9,15,11,.12) 100%),url('https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=2000&q=85') center/cover no-repeat}
.section{background:#101410;color:#f3f5ef}
.section-head p,.card p,.step p{color:#aab4a7}
.kicker{color:#c7f36b}
.section h2{letter-spacing:-1.8px}
.cards{gap:16px}
.card{background:#171e17;border:1px solid rgba(255,255,255,.13);color:#f3f5ef;transition:transform .25s,border-color .25s}
.card:hover{transform:translateY(-5px);border-color:rgba(199,243,107,.55)}
.cardimg{height:245px;background:#253025}
.cardbody{padding:25px}
.tag{color:#c7f36b}
.textlink{color:#c7f36b}
.textlink span{color:#c7f36b}
.band{background:#c7f36b;color:#11170e}
.band p{color:#334128}
.band .btn{background:#11170e;color:#c7f36b}
.projects{background:#141a14;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}
.projects .section-head p{color:#aab4a7}
.projects .kicker{color:#c7f36b}
.project{background:#222b22}
.step{border-color:rgba(255,255,255,.18)}
.step b{color:#c7f36b}
.quote{background:#171e17;color:#f3f5ef}
.quoteintro p{color:#aab4a7}
.quoteintro .kicker{color:#c7f36b}
.contactline{border-color:rgba(255,255,255,.17);color:#aab4a7}
.formbox{background:#101410;border:1px solid rgba(255,255,255,.15)}
.field label{color:#d6ddd2}
.field input,.field select,.field textarea{background:#171e17;border-color:rgba(255,255,255,.17);color:#f3f5ef}
.field input::placeholder,.field textarea::placeholder{color:#7f8a7d}
.field input:focus,.field select:focus,.field textarea:focus{border-color:#c7f36b}
.formnote{color:#9aa596}
.notice{background:#263321;color:#e5f4d4}
.footer{background:#090d09}
.mobilecta{background:rgba(9,13,9,.96)}
@media(max-width:560px){
 .hero{min-height:590px}
 .hero:before{background:linear-gradient(90deg,rgba(9,15,11,.95),rgba(9,15,11,.58)),url('https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=1400&q=80') center/cover}
 .cardimg{height:230px}
}


/* Interactive court simulator */
.simulator{background:#0b100d;color:#f5f7f3;position:relative;overflow:hidden}
.simulator:before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 18% 20%,rgba(149,190,78,.13),transparent 40%);pointer-events:none}
.simulator .wrap{position:relative}.simulator .section-head h2{color:#f5f7f3}.simulator .section-head p{color:#b6c0b6}
.simgrid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:24px;align-items:stretch}
.simstage{background:#141b16;border:1px solid #303a30;border-radius:18px;padding:20px;display:flex;flex-direction:column;justify-content:center;min-width:0}
.simstagehead{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px;color:#c9d2c7;font-size:11px;letter-spacing:1.4px;text-transform:uppercase}
.simcanvas{background:linear-gradient(145deg,#1b281e,#101711);border-radius:12px;padding:clamp(12px,3vw,28px);overflow:hidden}
.simcanvas{padding:0;position:relative;background:#111811;isolation:isolate}
/* Modular sports-complex puzzle builder — no photo preview */
.puzzleboard{position:relative;min-height:360px;padding:18px;background:#101711;border-radius:12px;overflow:hidden;isolation:isolate}
.puzzleboard:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:24px 24px;pointer-events:none}
.puzzle-meta{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;color:#b7c7b6;font-size:10px;letter-spacing:1.1px;text-transform:uppercase;margin-bottom:14px;position:relative}
.puzzle-layout{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(78px,auto);gap:7px;position:relative}
.puzzle-tile{min-width:0;position:relative;border:1px solid rgba(232,240,226,.55);border-radius:8px;padding:7px 4px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:#f5f7f3;background:#26392b;box-shadow:0 4px 12px rgba(0,0,0,.2);animation:tileIn .28s ease both;overflow:hidden}
.puzzle-tile:after{content:"";position:absolute;inset:3px;border:1px dashed rgba(255,255,255,.16);border-radius:5px;pointer-events:none}
.puzzle-tile svg{width:100%;max-width:90px;height:46px;position:relative;z-index:1}
.puzzle-tile span{font-size:9px;font-weight:800;letter-spacing:.5px;text-align:center;line-height:1.25;z-index:1}
.puzzle-tile.court{grid-column:span 2;grid-row:span 2;background:var(--turf,#326c45);border-color:var(--frame,#dce0d9)}
.puzzle-tile.court svg{max-width:180px;height:105px}
.puzzle-tile.facility{background:#38433b}
.puzzle-tile.parking{background:#343b3a}
.puzzle-tile.cafe{background:#65513a}
.puzzle-tile.shop{background:#354a54}
.puzzle-tile.lockers{background:#4b414c}
.puzzle-tile.roof{outline:2px solid #d5e7a0;outline-offset:-4px}
.puzzle-tile.lighting:before{content:"✦";position:absolute;right:7px;top:5px;color:#fff3b0;font-size:12px}
@keyframes tileIn{from{opacity:0;transform:scale(.88) translateY(5px)}to{opacity:1;transform:scale(1) translateY(0)}}
.module-picks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.module-pick{display:flex;align-items:center;gap:8px;padding:10px;border:1px solid #d7ddd3;border-radius:8px;background:#fff;font-size:12px;font-weight:650;cursor:pointer}
.module-pick input{accent-color:#587d40;width:16px;height:16px}
.module-pick:has(input:checked){background:#e8efdf;border-color:#77965d}
@media(max-width:560px){.puzzleboard{padding:12px;min-height:300px}.puzzle-layout{grid-auto-rows:minmax(65px,auto);gap:5px}.puzzle-tile.court svg{height:80px}.puzzle-tile span{font-size:8px}.module-picks{grid-template-columns:1fr 1fr}}
.simhint{font-size:12px;color:#aab5a9;margin:14px 0 0;line-height:1.6}
.simcontrols{background:#f4f5f0;color:#172018;border-radius:18px;padding:24px;display:flex;flex-direction:column;gap:18px}
.simcontrols h3{font-size:23px;line-height:1.1;margin:0}.simcontrols>p{margin:-9px 0 0;color:#687268;font-size:13px;line-height:1.6}
.simfield{display:flex;flex-direction:column;gap:8px}.simfield label{font-size:10px;letter-spacing:1.3px;font-weight:800;color:#586458}.simfield select,.simfield input[type=number]{width:100%;padding:12px 13px;border:1px solid #d7ddd4;border-radius:9px;background:white;color:#172018;font:inherit;min-height:44px}
.simchecks{display:grid;grid-template-columns:1fr 1fr;gap:10px}.simcheck{display:flex;align-items:center;gap:9px;border:1px solid #d7ddd4;border-radius:9px;padding:12px;font-size:12px;font-weight:650}.simcheck input{accent-color:#729b39;width:17px;height:17px}
.simsummary{border-top:1px solid #d7ddd4;padding-top:15px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.simstat small{display:block;font-size:9px;letter-spacing:1.2px;color:#667166;margin-bottom:4px}.simstat strong{font-size:17px}.simactions{display:flex;flex-direction:column;gap:9px}.simactions .btn{width:100%;justify-content:center;text-align:center;cursor:pointer}.simsecondary{border:1px solid #cdd5ca;color:#263127;border-radius:999px;padding:12px 16px;text-align:center;font-size:11px;font-weight:800;letter-spacing:1px;background:transparent;cursor:pointer}
@media(max-width:800px){.simgrid{grid-template-columns:1fr}.simstage{padding:14px}.simcontrols{padding:20px}.simcanvas{padding:12px}}


.court-render{position:relative;min-height:350px;padding:8px;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at center,#25342a,#101711 72%);overflow:hidden}
.court-render svg{width:100%;max-width:620px;height:auto;filter:drop-shadow(0 24px 18px rgba(0,0,0,.38));transition:all .35s ease}
.build-progress{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:2px 0 0}
.build-progress button{border:1px solid #d7ddd4;border-radius:9px;background:#fff;padding:10px 4px;display:flex;flex-direction:column;gap:4px;align-items:center;cursor:pointer;color:#687268}
.build-progress button b{font-size:15px}.build-progress button span{font-size:9px;font-weight:800;letter-spacing:.7px}
.build-progress button.active{background:#e7efd9;border-color:#77965d;color:#20331c;box-shadow:inset 0 -3px #77965d}
.build-step-title{font-size:11px;font-weight:850;letter-spacing:.8px;color:#4c6340;padding:9px 11px;background:#e8efdf;border-radius:8px}
.simfield.step-hidden,.simchecks.step-hidden,.module-field.step-hidden{display:none!important}
.step-nav{display:flex;gap:9px}.step-nav button{flex:1;border:1px solid #cdd5ca;border-radius:999px;padding:12px;background:transparent;color:#263127;font-weight:800;cursor:pointer}.step-nav button.primary{background:#172018;color:#c7f36b;border-color:#172018}
@media(max-width:560px){.court-render{min-height:270px}.build-progress button span{font-size:8px}}

</style>
</head>
<body>
<div class="topbar"><div class="wrap"><span>ENGINEERED FOR THE GAME.</span><span>PADEL COURTS · EQUIPMENT · PARTS</span></div></div>
<header class="nav"><div class="wrap navin">
<a class="brand" href="#home" aria-label="Rhythm Sport home"><span class="brandmark">R</span><span>RHYTHM SPORT<small>PADEL SPECIALISTS</small></span></a>
<button class="menu" id="menuBtn" aria-label="Open navigation" aria-expanded="false">☰</button>
<nav class="links" id="navLinks"><a href="#courts">Padel Courts</a><a href="#simulator">Court Simulator</a><a href="#equipment">Equipment & Parts</a><a href="#projects">Projects</a><a href="#process">Our Process</a><a class="btn" href="#quote">REQUEST A QUOTE ↗</a></nav>
</div></header>
<main>
<section class="hero" id="home"><div class="wrap">
<div class="eyebrow">PADEL COURTS · EQUIPMENT · COMPONENTS</div>
<h1>PADEL.<br><span>BUILT BETTER.</span></h1>
<p>Premium padel court systems, carefully selected equipment and dependable components — designed around your project, space and goals.</p>
<div class="actions"><a class="btn" href="#courts">EXPLORE PADEL COURTS ↗</a><a class="btn btn-outline" href="#quote">DISCUSS YOUR PROJECT</a></div>
<div class="hero-note"><b></b> ENGINEERED FOR THE GAME</div>
</div></section>
<section class="section" id="courts"><div class="wrap">
<div class="section-head"><div><div class="kicker">01 / COURT SOLUTIONS</div><h2>The right court for<br>your next project.</h2></div><p>Explore padel court solutions and choose the features that fit your site, audience and operating needs.</p></div>
<div class="cards">
<article class="card"><div class="cardimg"><img src="https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=900&q=80" alt="Padel court with green playing surface" loading="lazy"></div><div class="cardbody"><div class="tag">COURT SYSTEMS</div><h3>Padel Courts</h3><p>Court structures, glass panels, mesh, turf and essential components for new installations.</p><a class="textlink" href="#quote">ASK ABOUT COURTS <span>↗</span></a></div></article>
<article class="card"><div class="cardimg"><img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=900&q=80" alt="Sports facility equipment detail" loading="lazy"></div><div class="cardbody"><div class="tag">LIGHTING & ACCESSORIES</div><h3>Court Equipment</h3><p>Lighting and practical accessories to help complete your court specification.</p><a class="textlink" href="#quote">EXPLORE OPTIONS <span>↗</span></a></div></article>
<article class="card" id="equipment"><div class="cardimg"><img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=900&q=80" alt="Technical components in a workshop" loading="lazy"></div><div class="cardbody"><div class="tag">MAINTENANCE & REPLACEMENT</div><h3>Parts & Components</h3><p>Request replacement parts and components for maintenance, repairs or court upgrades.</p><a class="textlink" href="#quote">REQUEST PARTS <span>↗</span></a></div></article>
</div></div></section>
<section class="section simulator" id="simulator"><div class="wrap">
<div class="section-head"><div><div class="kicker">INTERACTIVE PLANNER</div><h2>Build your court.<br>Explore the options.</h2></div><p>Configure a preliminary court concept and send your requirements for a tailored quotation. No public prices are shown; availability, delivery, installation and final specifications are confirmed for each country and project.</p></div>
<div class="simgrid"><div class="simstage"><div class="simstagehead"><span>LIVE COURT PREVIEW</span><span id="simModeLabel">OUTDOOR · 1 COURT</span></div><div class="simcanvas" id="simScene" data-turf="green" data-frame="silver" data-type="outdoor" data-model="standard" data-lights="true" data-roof="false"><div class="puzzleboard"><div class="puzzle-meta"><span>LIVE MODULAR SITE PLAN</span><span id="sceneModelBadge">1 COURT · CONCEPT</span></div><div id="courtRender" class="court-render" aria-live="polite"></div><div class="puzzle-meta" style="margin:14px 0 0"><span id="sceneCaption">GREEN TURF · SILVER FRAME</span><span id="sceneEnvironment">OUTDOOR · LED</span></div></div></div><p class="simhint">This is a live schematic site-planning concept, not a construction drawing. Each selected facility is added as a connected module. Final footprint, spacing, access, safety and planning requirements must be confirmed for the project site.</p></div>
<div class="simcontrols"><h3>Build your court step by step</h3><p>Choose each layer in order. Every choice stays on the same live court preview.</p><div class="build-progress" id="buildProgress"><button type="button" class="active" data-step="0"><b>01</b><span>GROUND</span></button><button type="button" data-step="1"><b>02</b><span>STRUCTURE</span></button><button type="button" data-step="2"><b>03</b><span>LIGHTS</span></button><button type="button" data-step="3"><b>04</b><span>FINISH</span></button></div><div class="build-step-title" id="buildStepTitle">STEP 1 — CHOOSE YOUR PLAYING SURFACE</div>
<div class="simfield"><label for="simCourtModel">COURT MODEL</label><select id="simCourtModel"><option value="standard" selected>Standard court</option><option value="panoramic">Panoramic court (subject to availability)</option></select></div>
<div class="simfield"><label for="simTurf">TURF COLOUR</label><select id="simTurf"><option value="green" selected>Classic green</option><option value="blue">Competition blue</option><option value="terracotta">Terracotta</option><option value="dark">Deep graphite</option></select></div>
<div class="simfield"><label for="simFrame">FRAME FINISH</label><select id="simFrame"><option value="silver" selected>Silver aluminium</option><option value="black">Matte black</option><option value="white">White</option></select></div>
<div class="simfield"><label for="simType">INSTALLATION TYPE</label><select id="simType"><option value="outdoor" selected>Outdoor</option><option value="indoor">Indoor</option></select></div>
<div class="simfield"><label for="simCount">NUMBER OF COURTS</label><input id="simCount" type="number" min="1" max="100" step="1" value="1" inputmode="numeric" aria-describedby="simCountHelp"><small id="simCountHelp" style="color:#687268;font-size:11px">Enter a whole number from 1 to 100.</small></div>
<div class="simfield"><label for="simDelivery">SERVICE REQUIRED</label><select id="simDelivery"><option value="supply_install" selected>Supply and installation (subject to country)</option><option value="supply_only">Supply only</option><option value="discuss">Help me decide</option></select></div>
<div class="simfield"><label for="simCurrency">PREFERRED QUOTATION CURRENCY</label><select id="simCurrency"><option value="EUR" selected>EUR — Euro</option><option value="USD">USD — US Dollar</option><option value="GBP">GBP — Pound Sterling</option><option value="local">Local currency / advise me</option></select></div>
<div class="simchecks"><label class="simcheck"><input id="simLights" type="checkbox" checked> LED lighting</label><label class="simcheck"><input id="simRoof" type="checkbox"> Covered venue</label></div>
<div class="simfield"><label>ADD FACILITY MODULES</label><div class="module-picks"><label class="module-pick"><input id="modClubhouse" type="checkbox" checked> Clubhouse / reception</label><label class="module-pick"><input id="modCafe" type="checkbox"> Café / lounge</label><label class="module-pick"><input id="modLockers" type="checkbox"> Changing rooms</label><label class="module-pick"><input id="modParking" type="checkbox"> Parking area</label><label class="module-pick"><input id="modShop" type="checkbox"> Pro shop</label><label class="module-pick"><input id="modTraining" type="checkbox"> Training zone</label></div></div>
<div class="simsummary"><div class="simstat"><small>PLAYING AREA / COURT</small><strong>200 m²</strong></div><div class="simstat"><small>SELECTED QUANTITY</small><strong id="simQuantity">1 court</strong></div><div class="simstat"><small>PLAYING AREA TOTAL</small><strong id="simArea">200 m²</strong></div><div class="simstat"><small>PROJECT TYPE</small><strong id="simProjectType">Outdoor</strong></div>
<div class="simstat"><small>PRICING</small><strong>Quote only</strong></div></div>
<div class="simactions"><button class="btn" id="simQuoteBtn" type="button">SEND COMPLEX TO WHATSAPP ↗</button><button class="simsecondary" id="simResetBtn" type="button">RESET CONFIGURATION</button></div><div id="simNotice" class="simhint" role="status" aria-live="polite"></div>
</div></div></div></section>

<section class="band"><div class="wrap bandin"><div><h2>Planning a padel project?</h2><p>Tell us what you need. We’ll help define the next steps.</p></div><a class="btn" href="#quote">GET A PROJECT QUOTE ↗</a></div></section>
<section class="section projects" id="projects"><div class="wrap"><div class="section-head"><div><div class="kicker">02 / PROJECT EXPERIENCE</div><h2>Made for the<br>court. Built for use.</h2></div><p>Every project begins with understanding the space, requirements and intended use. Verified project examples can be added here as they are approved.</p></div>
<div class="projectgrid"><article class="project"><img src="https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=1200&q=80" alt="Padel court facility" loading="lazy"><div class="projecttext"><small>COURT SOLUTIONS</small><h3>From plan to playing surface</h3><p>Explore court options for your next installation.</p></div></article><article class="project"><img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=900&q=80" alt="Workshop and technical components" loading="lazy"><div class="projecttext"><small>EQUIPMENT & PARTS</small><h3>The details matter</h3><p>Components and equipment for court projects.</p></div></article></div>
</div></section>
<section class="section" id="process"><div class="wrap"><div class="section-head"><div><div class="kicker">03 / HOW WE WORK</div><h2>A clear route from<br>idea to installation.</h2></div><p>A straightforward process helps define the requirements before specifications and pricing are confirmed.</p></div>
<div class="process"><div class="step"><b>STEP 01</b><h3>Discover</h3><p>Share your site, goals, preferred court type and initial requirements.</p></div><div class="step"><b>STEP 02</b><h3>Specify</h3><p>Review dimensions, equipment options and key project details.</p></div><div class="step"><b>STEP 03</b><h3>Quote</h3><p>Receive a quotation proposal based on the information provided.</p></div><div class="step"><b>STEP 04</b><h3>Plan Next Steps</h3><p>Confirm scope, schedule and delivery details directly with the team.</p></div></div>
</div></section>
<section class="section quote" id="quote"><div class="wrap quotegrid"><div class="quoteintro"><div class="kicker">04 / START A CONVERSATION</div><h2>Tell us about<br>your padel project.</h2><p>Looking for a complete court, specific equipment or replacement parts? Send us your requirements to start an enquiry.</p><div class="contactline">PROJECT ENQUIRIES<br><strong>Request a tailored quotation. No prices are published by this configurator.</strong></div></div>
<form class="formbox" id="quoteForm"><div class="formgrid">
<div class="field"><label for="name">YOUR NAME *</label><input id="name" name="name" required placeholder="Full name"></div>
<div class="field"><label for="email">EMAIL ADDRESS *</label><input id="email" name="email" type="email" required placeholder="you@company.com"></div>
<div class="field"><label for="company">COMPANY</label><input id="company" name="company" placeholder="Company name"></div>
<div class="field"><label for="country">PROJECT COUNTRY *</label><input id="country" name="country" required placeholder="Country"></div>
<div class="field"><label for="interest">I'M INTERESTED IN *</label><select id="interest" name="interest" required><option value="">Choose an option</option><option>Complete padel court</option><option>Court equipment</option><option>Replacement parts</option><option>Multiple products / project</option></select></div>
<div class="field"><label for="quantity">QUANTITY / COURTS</label><input id="quantity" name="quantity" placeholder="e.g. 2 courts"></div>
<div class="field"><label for="quoteCurrency">PREFERRED QUOTATION CURRENCY</label><select id="quoteCurrency" name="quoteCurrency"><option value="EUR">EUR — Euro</option><option value="USD">USD — US Dollar</option><option value="GBP">GBP — Pound Sterling</option><option value="Local currency / advise me">Local currency / advise me</option></select></div>
<div class="field"><label for="serviceScope">SERVICE REQUIRED</label><select id="serviceScope" name="serviceScope"><option value="Supply and installation (subject to country)">Supply and installation (subject to country)</option><option value="Supply only">Supply only</option><option value="Please advise">Please advise</option></select></div>
<div class="field full"><label for="details">PROJECT DETAILS</label><textarea id="details" name="details" placeholder="Dimensions, indoor/outdoor, preferred equipment, timeline..."></textarea></div>
</div><button class="btn" type="submit">PREPARE MY ENQUIRY ↗</button><div class="formnote">Your enquiry will open WhatsApp with the project details pre-filled. The company WhatsApp number must be configured before launch. Prices, delivery and installation are confirmed after review.</div><div class="notice" id="formNotice" role="status"></div></form>
</div></section>
</main>
<footer class="footer"><div class="wrap"><div class="footergrid"><div><a class="brand" href="#home"><span class="brandmark">R</span><span>RHYTHM SPORT<small>PADEL SPECIALISTS</small></span></a><p>Padel courts, equipment and parts for projects that start with a clear plan.</p></div><div class="footlinks"><a href="#courts">Padel Courts</a><a href="#equipment">Equipment & Parts</a><a href="#projects">Projects</a><a href="#quote">Request a Quote</a></div></div><div class="copyright"><span>© <span id="year"></span> Rhythm Sport. All rights reserved.</span><span>Built around padel.</span></div></div></footer>
<div class="mobilecta"><a class="btn" href="#quote">REQUEST A QUOTE ↗</a></div>
<script>
const menuBtn=document.getElementById('menuBtn'),navLinks=document.getElementById('navLinks');
menuBtn.addEventListener('click',()=>{const open=navLinks.classList.toggle('open');menuBtn.setAttribute('aria-expanded',String(open));menuBtn.textContent=open?'✕':'☰'});
navLinks.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{navLinks.classList.remove('open');menuBtn.setAttribute('aria-expanded','false');menuBtn.textContent='☰'}));
document.getElementById('year').textContent=new Date().getFullYear();

const simCourtModel=document.getElementById('simCourtModel');
const simTurf=document.getElementById('simTurf'),simFrame=document.getElementById('simFrame'),simType=document.getElementById('simType'),simCount=document.getElementById('simCount'),simLights=document.getElementById('simLights'),simRoof=document.getElementById('simRoof'),simDelivery=document.getElementById('simDelivery'),simCurrency=document.getElementById('simCurrency');

const moduleControls={clubhouse:document.getElementById('modClubhouse'),cafe:document.getElementById('modCafe'),lockers:document.getElementById('modLockers'),parking:document.getElementById('modParking'),shop:document.getElementById('modShop'),training:document.getElementById('modTraining')};
const moduleLabels={clubhouse:'CLUBHOUSE',cafe:'CAFÉ / LOUNGE',lockers:'CHANGING ROOMS',parking:'PARKING',shop:'PRO SHOP',training:'TRAINING ZONE'};
const turfColors={green:'#326c45',blue:'#176c9c',terracotta:'#a84d35',dark:'#353a38'};
const frameColors={silver:'#dce0d9',black:'#222724',white:'#f8f8f1'};
const COURT_PLAYING_AREA_M2=200,MIN_COURTS=1,MAX_COURTS=20;
function readCourtConfiguration(){
 const rawCount=String(simCount.value).trim(),count=Number(rawCount),errors=[];
 if(rawCount===''||!Number.isInteger(count)||count<MIN_COURTS||count>MAX_COURTS)errors.push('Enter a whole number of courts from 1 to 20.');
 const modules=Object.keys(moduleControls).filter(k=>moduleControls[k].checked);
 return {schemaVersion:2,courtModel:simCourtModel.value,turf:simTurf.value,frame:simFrame.value,installationType:simType.value,courtCount:count,lighting:simLights.checked,coveredVenue:simRoof.checked,serviceScope:simDelivery.value,preferredCurrency:simCurrency.value,modules,playingAreaPerCourtM2:COURT_PLAYING_AREA_M2,playingAreaTotalM2:Number.isInteger(count)&&count>=MIN_COURTS&&count<=MAX_COURTS?count*COURT_PLAYING_AREA_M2:null,pricingMode:'quotation_required',errors};
}
function iconSvg(kind,config){
 const stroke=frameColors[config.frame]||'#e7ece4', turf=turfColors[config.turf]||'#326c45';
 if(kind==='court')return `<svg viewBox="0 0 180 105" aria-hidden="true"><rect x="10" y="8" width="160" height="89" rx="2" fill="${turf}" stroke="${stroke}" stroke-width="3"/><rect x="17" y="15" width="146" height="75" fill="none" stroke="#f3f5ed" stroke-width="1.5"/><path d="M90 15V90 M17 52.5H163 M53 15V90 M127 15V90" stroke="#f3f5ed" stroke-width="1.2" opacity=".9"/><circle cx="90" cy="52.5" r="4" fill="#f3f5ed"/></svg>`;
 const paths={clubhouse:'<rect x="15" y="17" width="60" height="31" rx="2"/><path d="M10 18L45 4L80 18M27 48V29H41V48M52 28H64V38H52Z"/>',cafe:'<path d="M20 17H68V47H20Z M68 23H78V38H68 M26 10H62 M30 51V58 M60 51V58"/><circle cx="44" cy="31" r="8"/>',lockers:'<rect x="17" y="8" width="58" height="49" rx="2"/><path d="M36 8V57 M55 8V57 M25 20H29 M44 20H48 M63 20H67"/>',parking:'<path d="M12 12H78V53H12Z M22 12V53 M34 12V53 M46 12V53 M58 12V53 M70 12V53"/><path d="M40 20V44 M40 20H50Q60 20 50 32H40"/>',shop:'<path d="M18 25H74V55H18Z M14 25L22 10H70L78 25 M30 25V55 M47 25V55 M64 25V55"/>',training:'<circle cx="45" cy="30" r="20"/><path d="M25 30H65 M45 10V50 M31 16L59 44 M59 16L31 44"/>'};
 return `<svg viewBox="0 0 90 65" aria-hidden="true" fill="none" stroke="${stroke}" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round">${paths[kind]||paths.clubhouse}</svg>`;
}
function updatePuzzle(config){
 const turf=turfColors[config.turf]||turfColors.green, frame=frameColors[config.frame]||frameColors.silver;
 const courtCount=Math.max(1,Math.min(4,Number(config.courtCount)||1));
 const courts=[]; for(let i=0;i<courtCount;i++){const x=45+i*112; courts.push(`<g transform="translate(${x} ${i%2?38:54})"><rect x="0" y="0" width="104" height="190" rx="2" fill="#000" opacity=".22" transform="translate(4 5)"/><rect x="0" y="0" width="104" height="190" rx="2" fill="${turf}" stroke="${frame}" stroke-width="${config.courtModel==='panoramic'?2.4:4}"/><rect x="8" y="8" width="88" height="174" fill="none" stroke="#f7f7ee" stroke-width="1.6"/><path d="M8 95H96 M52 8V182 M29 8V182 M75 8V182" stroke="#f7f7ee" stroke-width="1.2" opacity=".9"/><circle cx="52" cy="95" r="3" fill="#fff"/>${config.courtModel==='panoramic'?'<path d="M0 0V190 M104 0V190" stroke="#d9f1f4" stroke-width="3"/>':''}</g>`)}
 const countShown=courtCount;
 const roof=config.coveredVenue?`<g><path d="M28 44 L${countShown*112+36} 44 L${countShown*112+36} 26 L28 26 Z" fill="#dce4d8" opacity=".13" stroke="#e5eee2" stroke-width="2"/><path d="M28 44 L28 250 M${countShown*112+36} 44 L${countShown*112+36} 250" stroke="${frame}" stroke-width="4" opacity=".9"/><path d="M28 26 L${countShown*112+36} 26" stroke="${frame}" stroke-width="5"/></g>`:'';
 const lights=config.lighting?`<g fill="#fff4bc" stroke="#fff4bc">${Array.from({length:countShown*2},(_,i)=>{let x=55+i*56;return `<circle cx="${x}" cy="${i%2?30:270}" r="4"/><path d="M${x} ${i%2?34:266} L${x} ${i%2?48:252}" stroke-width="2" opacity=".9"/><circle cx="${x}" cy="${i%2?30:270}" r="12" fill="#fff4bc" opacity=".10"/>`}).join('')}</g>`:'';
 const modules=config.modules.map((m,i)=>{const x=38+(i%3)*116,y=292+Math.floor(i/3)*34;return `<g transform="translate(${x} ${y})"><rect width="102" height="25" rx="4" fill="${({clubhouse:'#687b5a',cafe:'#92734f',lockers:'#5e586b',parking:'#4a5754',shop:'#4e6d78',training:'#777f45'})[m]||'#596958'}" stroke="#dce4d8" stroke-opacity=".6"/><text x="51" y="16" text-anchor="middle" font-size="8" font-weight="700" fill="#fff">${moduleLabels[m].replace('&','and')}</text></g>`}).join('');
 document.getElementById('courtRender').innerHTML=`<svg viewBox="0 0 ${Math.max(250,countShown*112+100)} 390" role="img" aria-label="Live layered padel court configuration"><defs><linearGradient id="ground" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#314334"/><stop offset="1" stop-color="#17221a"/></linearGradient><linearGradient id="glass" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#d7f1f3" stop-opacity=".28"/><stop offset="1" stop-color="#8bc4cc" stop-opacity=".06"/></linearGradient></defs><rect width="100%" height="100%" fill="url(#ground)"/><path d="M12 285 L${countShown*112+65} 285 L${countShown*112+65} 300 L12 300Z" fill="#0a100c" opacity=".55"/>${roof}${courts.join('')}<g fill="url(#glass)" stroke="${frame}" stroke-width="2" opacity=".9">${Array.from({length:countShown},(_,i)=>{let x=45+i*112;return `<rect x="${x}" y="${54}" width="104" height="190" fill="url(#glass)" stroke-dasharray="${config.courtModel==='panoramic'?'':'3 3'}"/>`}).join('')}</g>${lights}${modules}<text x="16" y="374" fill="#d5e1d3" font-size="9" letter-spacing="1.4">LIVE BUILD · ${config.installationType.toUpperCase()} · ${config.courtModel.toUpperCase()}</text></svg>`;
 document.getElementById('sceneModelBadge').textContent=`${config.courtCount} COURT${config.courtCount===1?'':'S'} · ${config.modules.length} EXTRA MODULES`;
 document.getElementById('sceneCaption').textContent=`${config.turf.toUpperCase()} TURF · ${config.frame.toUpperCase()} FRAME`;
 document.getElementById('sceneEnvironment').textContent=`${config.installationType.toUpperCase()} · ${config.lighting?'LED LIGHTING':'NO LIGHTING'} · ${config.coveredVenue?'COVERED':'OPEN AIR'}`;
}
function updateSimulator(){
 const config=readCourtConfiguration();updatePuzzle(config);
 const valid=config.errors.length===0;
 document.getElementById('simQuantity').textContent=valid?config.courtCount+' court'+(config.courtCount===1?'':'s'):'Check quantity';
 document.getElementById('simArea').textContent=valid?config.playingAreaTotalM2.toLocaleString()+' m²':'—';
 document.getElementById('simProjectType').textContent=config.installationType==='indoor'?'Indoor':'Outdoor';
 document.getElementById('simModeLabel').textContent=(config.installationType.toUpperCase())+' · '+(valid?config.courtCount:'—')+' COURT'+(config.courtCount===1?'':'S');
 simCount.setAttribute('aria-invalid',String(!valid));document.getElementById('simQuoteBtn').disabled=!valid;
 document.getElementById('simNotice').textContent=valid?'No prices shown. Your selected layout and requirements will be sent to the company WhatsApp for a tailored quotation.':'Enter a whole number of courts from 1 to 20.';
 return config;
}
[simCourtModel,simTurf,simFrame,simType,simCount,simLights,simRoof,simDelivery,simCurrency,...Object.values(moduleControls)].forEach(el=>el.addEventListener('change',updateSimulator));
const buildSteps=[
 {title:'STEP 1 — CHOOSE YOUR PLAYING SURFACE',ids:['simTurf','simCourtModel']},
 {title:'STEP 2 — ADD THE COURT STRUCTURE',ids:['simFrame','simType','simCount']},
 {title:'STEP 3 — ADD LIGHTING',ids:['simLights']},
 {title:'STEP 4 — FINISH YOUR PROJECT',ids:['simRoof','simDelivery','simCurrency','modClubhouse','modCafe','modLockers','modParking','modShop','modTraining']}
];
let activeBuildStep=0;
function setupBuildSteps(){
 const controls=document.querySelector('.simcontrols');
 buildSteps.forEach((step,index)=>step.ids.forEach(id=>{const el=document.getElementById(id);if(!el)return;const group=el.closest('.simfield,.simchecks,.module-picks')?.closest('.simfield')||el.closest('.simfield')||el.closest('.simchecks')||el.closest('.module-picks');if(group){group.dataset.buildStep=index;}}));
 const moduleWrap=document.querySelector('.module-picks')?.parentElement;if(moduleWrap){moduleWrap.classList.add('simfield');moduleWrap.dataset.buildStep='3';moduleWrap.classList.add('module-field');}
 document.querySelectorAll('#simLights,#simRoof').forEach(el=>{const label=el.closest('label');const wrap=document.createElement('div');wrap.className='simfield';wrap.dataset.buildStep=el.id==='simLights'?'2':'3';wrap.appendChild(label);document.querySelector('.simchecks').parentElement.insertBefore(wrap,document.querySelector('.simchecks'));});document.querySelector('.simchecks').remove();
 const nav=document.createElement('div');nav.className='step-nav';nav.innerHTML='<button type="button" id="buildBack">← BACK</button><button type="button" class="primary" id="buildNext">NEXT STEP →</button>';controls.insertBefore(nav,document.querySelector('.simsummary'));
 function showStep(n){activeBuildStep=Math.max(0,Math.min(3,n));document.querySelectorAll('.simfield[data-build-step],.simchecks[data-build-step]').forEach(el=>el.classList.toggle('step-hidden',Number(el.dataset.buildStep)!==activeBuildStep));document.querySelectorAll('#buildProgress button').forEach((b,i)=>{b.classList.toggle('active',i===activeBuildStep);b.setAttribute('aria-current',i===activeBuildStep?'step':'false')});document.getElementById('buildStepTitle').textContent=buildSteps[activeBuildStep].title;document.getElementById('buildBack').disabled=activeBuildStep===0;document.getElementById('buildNext').textContent=activeBuildStep===3?'REVIEW & REQUEST QUOTE ↗':'NEXT STEP →';}
 document.querySelectorAll('#buildProgress button').forEach(b=>b.addEventListener('click',()=>showStep(Number(b.dataset.step))));document.getElementById('buildBack').addEventListener('click',()=>showStep(activeBuildStep-1));document.getElementById('buildNext').addEventListener('click',()=>{if(activeBuildStep<3)showStep(activeBuildStep+1);else document.getElementById('simQuoteBtn').scrollIntoView({behavior:'smooth',block:'center'})});showStep(0);
}
setupBuildSteps();

simCount.addEventListener('input',updateSimulator);

document.getElementById('simResetBtn').addEventListener('click',()=>{
  simCourtModel.value='standard';simTurf.value='green';simFrame.value='silver';simType.value='outdoor';simCount.value='1';simLights.checked=true;simRoof.checked=false;simDelivery.value='supply_install';simCurrency.value='EUR';Object.entries(moduleControls).forEach(([k,el])=>el.checked=k==='clubhouse');updateSimulator();
});

const COMPANY_WHATSAPP_NUMBER='905309730701'; // International format, digits only
function makeWhatsAppUrl(message){return 'https://wa.me/'+COMPANY_WHATSAPP_NUMBER+'?text='+encodeURIComponent(message)}
document.getElementById('simQuoteBtn').addEventListener('click',()=>{
 const config=updateSimulator();if(config.errors.length)return;
 const message=['RHYTHM SPORT — NEW SPORTS COMPLEX QUOTE REQUEST','',`Court model: ${simCourtModel.options[simCourtModel.selectedIndex].text}`,`Courts: ${config.courtCount}`,`Turf: ${simTurf.options[simTurf.selectedIndex].text}`,`Frame: ${simFrame.options[simFrame.selectedIndex].text}`,`Venue: ${simType.options[simType.selectedIndex].text}`,`LED lighting: ${config.lighting?'Yes':'No'}`,`Roof: ${config.coveredVenue?'Covered':'Open air'}`,`Facility modules: ${config.modules.map(k=>moduleLabels[k]).join(', ')||'None selected'}`,`Service: ${simDelivery.options[simDelivery.selectedIndex].text}`,`Preferred currency: ${simCurrency.options[simCurrency.selectedIndex].text}`,`Playing area total (courts only): ${config.playingAreaTotalM2} m²`,'','Please provide a quotation and confirm delivery/installation availability for my country.'].join('\n');
 if(!/^\d{8,15}$/.test(COMPANY_WHATSAPP_NUMBER)){document.getElementById('simNotice').textContent='The puzzle layout is ready. To activate direct WhatsApp quoting, the company WhatsApp number must be added to the site first.';document.getElementById('quote').scrollIntoView({behavior:'smooth'});document.getElementById('details').value=message;return;}
 window.open(makeWhatsAppUrl(message),'_blank','noopener');
});
updateSimulator();

document.getElementById('quoteForm').addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.target);const body=['RHYTHM SPORT — CUSTOMER ENQUIRY','',`Name: ${f.get('name')}`,`Email: ${f.get('email')}`,`Company: ${f.get('company')||'Not provided'}`,`Country: ${f.get('country')}`,`Interest: ${f.get('interest')}`,`Quantity: ${f.get('quantity')||'Not provided'}`,`Currency: ${f.get('quoteCurrency')}`,`Service: ${f.get('serviceScope')}`,'',`Project details: ${f.get('details')||'Not provided'}`].join('\n');if(!/^\d{8,15}$/.test(COMPANY_WHATSAPP_NUMBER)){const n=document.getElementById('formNotice');n.style.display='block';n.textContent='The enquiry is ready, but the company WhatsApp number must be configured before it can be sent.';return;}window.open(makeWhatsAppUrl(body),'_blank','noopener');});
</script>
</body>
</html>
